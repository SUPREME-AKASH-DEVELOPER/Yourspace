---
/**
 * The full YourSpace logo: YOUR with the eclipse for its O, SPACE set wide,
 * two rows of seats catching the light, all inside the gold ring.
 * Drawn as SVG from the brand artwork so it stays sharp at any size and can
 * move: the eclipse breathes, its shadow drifts, a glint runs round the ring.
 *
 * The A in SPACE is drawn as a chevron, as in the artwork, so the word is
 * three text runs around a path rather than one string.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);

// back row: six small seats; front row: four big ones, cut by the ring at the sides
const back = [62, 109, 156, 203, 250, 297].map((x) => ({ x, y: 284, w: 41, h: 30, r: 13 }));
const front = [30, 115, 200, 285].map((x) => ({ x, y: 318, w: 80, h: 60, r: 26 }));
const seat = (s: { x: number; y: number; w: number; h: number; r: number }) =>
  `M${s.x} ${s.y + s.h}V${s.y + s.r}a${s.r} ${s.r} 0 0 1 ${s.r}-${s.r}h${s.w - 2 * s.r}a${s.r} ${s.r} 0 0 1 ${s.r} ${s.r}V${s.y + s.h}`;
---
<span class={`brand-full ${cls}`} role="img" aria-label="YourSpace">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" focusable="false" aria-hidden="true">
    <defs>
      <linearGradient id={`fring-${uid}`} x1="40" y1="20" x2="360" y2="380" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#F3DCA6" />
        <stop offset=".4" stop-color="#B98F55" />
        <stop offset=".75" stop-color="#7A5A33" />
        <stop offset="1" stop-color="#C9A266" />
      </linearGradient>
      <linearGradient id={`ftext-${uid}`} x1="0" y1="130" x2="0" y2="270" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#EBD3A0" />
        <stop offset=".55" stop-color="#C39B62" />
        <stop offset="1" stop-color="#8C6A3E" />
      </linearGradient>
      <radialGradient id={`fhalo-${uid}`} cx=".5" cy=".5" r=".5">
        <stop offset="0" stop-color="#FFE6AE" stop-opacity=".75" />
        <stop offset=".35" stop-color="#E8B466" stop-opacity=".28" />
        <stop offset="1" stop-color="#C8964B" stop-opacity="0" />
      </radialGradient>
      <linearGradient id={`fmoon-${uid}`} x1="160" y1="125" x2="215" y2="200" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#FFF4D6" />
        <stop offset="1" stop-color="#E4A94F" />
      </linearGradient>
      <linearGradient id={`frim-${uid}`} x1="0" y1="300" x2="0" y2="370" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#E9C98B" stop-opacity=".9" />
        <stop offset="1" stop-color="#E9C98B" stop-opacity="0" />
      </linearGradient>
      <clipPath id={`fin-${uid}`}><circle cx="200" cy="200" r="178" /></clipPath>
    </defs>

    <circle cx="200" cy="200" r="190" fill="#070605" />
    <circle class="ys-ring" pathLength="100" cx="200" cy="200" r="186" fill="none"
            stroke={`url(#fring-${uid})`} stroke-width="3" />
    <circle cx="200" cy="200" r="179" fill="none" stroke={`url(#fring-${uid})`} stroke-width=".8" opacity=".45" />
    <circle class="ys-glint" pathLength="100" cx="200" cy="200" r="186" fill="none"
            stroke="#FFF0C8" stroke-width="3.6" stroke-linecap="round" />

    <g clip-path={`url(#fin-${uid})`}>
      <circle class="ys-halo" cx="165" cy="165" r="96" fill={`url(#fhalo-${uid})`} />

      <g class="ys-word" fill={`url(#ftext-${uid})`}>
        <text x="72" y="195" font-size="84" textLength="55" lengthAdjust="spacingAndGlyphs">Y</text>
        <text x="203" y="195" font-size="84" textLength="126" lengthAdjust="spacingAndGlyphs">UR</text>
        {[['S', 130], ['P', 165], ['C', 235], ['E', 270]].map(([ch, x]) => (
          <text x={x} y="248" text-anchor="middle" font-size="30">{ch}</text>
        ))}
      </g>
      <!-- the chevron A of SPACE -->
      <path class="ys-word" d="M190.5 248 200 226.5 209.5 248" fill="none"
            stroke={`url(#ftext-${uid})`} stroke-width="2.4" stroke-linejoin="miter" />

      <!-- the O: a crescent of light behind a dark disc -->
      <circle cx="165" cy="165" r="31" fill="none" stroke="#5C4628" stroke-width="1.2" opacity=".75" />
      <circle cx="165" cy="165" r="31" fill={`url(#fmoon-${uid})`} />
      <circle class="ys-shade" cx="157" cy="163" r="30" fill="#070605" />
      <circle class="ys-flare" cx="186" cy="146" r="3.2" fill="#FFF6DE" />
      <circle cx="186" cy="146" r="9" fill="#FFE3A6" opacity=".3" />

      <g class="ys-seats">
        {back.map((s) => <path d={seat(s)} fill="#0C0A08" stroke={`url(#frim-${uid})`} stroke-width="1.4" />)}
        {front.map((s) => <path d={seat(s)} fill="#0E0C0A" stroke={`url(#frim-${uid})`} stroke-width="2" />)}
      </g>
    </g>
  </svg>
</span>
