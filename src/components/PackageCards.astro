---
/**
 * The setups you book, from the same data the flow charges, so the two can't drift.
 *
 * Each card shows the same picture as that setup's card in the booking flow:
 * a photograph dropped in src/assets/booking/ as setup-<id>.jpg (or a stand-in
 * named setup-<id>.sample.jpg, which carries a "Sample image" badge), and for
 * Date Night our own decorated room. Shown whole over a blurred copy of itself.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { setups, setupPrice, ROOM_BASE } from '../data/booking';
import room from '../assets/decor/royal-3.jpeg';
import { backdrop, backdropStyle } from '../lib/backdrop';

const rupee = (n: number) => '₹' + n.toLocaleString('en-IN');
const priceOf = (id: string) => {
  const s = setups.find((x) => x.id === id)!;
  if (s.closed) return 'On call';
  if (s.perPerson) return `${rupee(s.perPerson)} pp`;
  return `From ${rupee(setupPrice(id, s.minGuests).amount ?? ROOM_BASE)}`;
};

type Pic = { src: ImageMetadata; sample: boolean };
const pics: Record<string, Pic> = { date: { src: room, sample: false } };
const dropped = import.meta.glob<{ default: ImageMetadata }>('../assets/booking/setup-*.{jpg,jpeg,png,webp}', { eager: true });
for (const [path, mod] of Object.entries(dropped)) {
  const base = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  const sample = base.endsWith('.sample');
  const id = base.replace(/^setup-/, '').replace(/\.sample$/, '');
  // a real photograph always wins over a stand-in
  if (!pics[id] || (pics[id].sample && !sample) || (id === 'date' && !sample)) pics[id] = { src: mod.default, sample };
}
const bgs = Object.fromEntries(await Promise.all(
  Object.entries(pics).map(async ([id, p]) => [id, await backdrop(p.src)] as const)));
---
<div class="pkgs">
  {setups.map((s) => {
    const pic = pics[s.id];
    return (
      <div class={`pkg reveal${pic ? ' has-media' : ''}`}>
        {s.closed && <span class="pkg-tag">Book by phone</span>}
        {pic && (
          <span class="pkg-media">
            <span class="fit-bg" aria-hidden="true" style={backdropStyle(bgs[s.id])}></span>
            <Image src={pic.src} alt={`${s.name}: ${s.tagline}${pic.sample ? ' (sample image)' : ''}`}
                   widths={[320, 640]} sizes="(max-width: 720px) 90vw, 300px" loading="lazy" />
            {pic.sample && <span class="vis-sample">Sample image</span>}
          </span>
        )}
        <div class="pkg-body">
          <span class="pkg-top">
            <strong>{s.name}</strong><span class="pkg-price num">{priceOf(s.id)}</span>
          </span>
          <p>{s.tagline}.</p>
          <ul>{s.includes.map((i) => <li>{i}</li>)}</ul>
          <p class="pkg-fine">
            {s.minutes ? `${s.minutes} min` : 'Duration on call'}
            {' · '}{s.minGuests > 1 ? `${s.minGuests}–${s.maxGuests}` : `Up to ${s.maxGuests}`} guests
            {s.perPerson && ` · minimum ${rupee(s.perPerson * s.minGuests)}`}
          </p>
        </div>
      </div>
    );
  })}
</div>
