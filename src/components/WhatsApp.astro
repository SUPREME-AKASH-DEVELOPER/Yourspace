---
/**
 * "For more information — contact us on WhatsApp".
 * The number and the opening message live in src/data/site.ts (`whatsapp`,
 * `whatsappMessage`). Renders nothing until a valid number is set there.
 *
 *   <WhatsApp />                     the full strip
 *   <WhatsApp variant="link" />      a plain link, for the footer
 *   <WhatsApp message="…" />         a different opening message
 */
import { whatsappLink } from '../data/site';

interface Props { variant?: 'strip' | 'link'; message?: string; class?: string }
const { variant = 'strip', message, class: cls = '' } = Astro.props;
const href = whatsappLink(message);
const icon = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.2a9.8 9.8 0 0 0-8.4 14.9L2.2 21.8l4.8-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.8a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.1 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.9 2c0 1.2.9 2.4 1 2.5.1.2 1.7 2.6 4.2 3.7 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.5-.5Z"/></svg>';
---
{href && variant === 'link' && (
  <a class={`wa-link ${cls}`} href={href} target="_blank" rel="noopener" data-whatsapp>
    <Fragment set:html={icon} />WhatsApp us
  </a>
)}
{href && variant === 'strip' && (
  <div class={`wa-strip ${cls}`}>
    <p><span class="wa-kicker">For more information</span>
      Questions before you book? Message us and a person replies.</p>
    <a class="btn btn-line wa-btn" href={href} target="_blank" rel="noopener" data-whatsapp>
      <Fragment set:html={icon} />Contact us on WhatsApp<span class="sr-only"> (opens WhatsApp)</span>
    </a>
  </div>
)}
