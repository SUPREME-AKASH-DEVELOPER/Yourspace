---
/**
 * The YourSpace logo, exactly as supplied (src/assets/brand/logo.png).
 *
 * It is made to feel alive with light laid over the artwork rather than by
 * redrawing it: the eclipse breathes, and a glint of light travels round the
 * gold ring. The overlays use `screen` blending, so they only ever add light,
 * and the logo's black background disappears into the dark page around it.
 * Everything holds still for visitors who have asked for reduced motion.
 *
 * Positions are measured from the artwork (1254 × 1254): the ring is centred
 * at 631,608 with a radius of 531; the crescent's bright tip is at 574,488.
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';

interface Props { class?: string; alt?: string; eager?: boolean }
const { class: cls = '', alt = 'YourSpace', eager = false } = Astro.props;
---
<span class={`brand-mark ${cls}`}>
  <Image src={logo} alt={alt} widths={[160, 320, 480]} sizes="(max-width: 860px) 130px, 160px"
         loading={eager ? 'eager' : 'lazy'} decoding="async" />
  <span class="ys-glint" aria-hidden="true"></span>
  <span class="ys-halo" aria-hidden="true"></span>
</span>
