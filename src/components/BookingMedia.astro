---
/**
 * The photographs the booking flow shows, rendered once here at build time so
 * they get the same resizing and modern formats as the rest of the site.
 *
 * The flow is drawn in the browser, so it clones these out of a <template> by
 * key (`data-media`). Nothing inside a <template> downloads until it is used.
 *
 * TO ADD THE OWNER'S PHOTOGRAPHS — no code needed:
 *   save the picture in src/assets/booking/ under its key, and rebuild.
 *     setup-movie.jpg     setup-karaoke.jpg     setup-watch.jpg
 *     addon-bouquet-s.jpg addon-bouquet-m.jpg   addon-bouquet-l.jpg
 *     addon-cake-strawberry.jpg  addon-cake-chocolate.jpg
 *     addon-photo-15.jpg
 *   (any of .jpg .jpeg .png .webp). The key is "setup-" or "addon-" plus the id
 *   in src/data/booking.ts, so a new cake added there gets its own key too.
 *   The alt text comes from the item's name. Anything without a photograph
 *   shows a drawn gold card in its place.
 *
 * TEMPORARY / AI-GENERATED PICTURES
 *   Name them with ".sample" before the extension — addon-bouquet-s.sample.jpg.
 *   They show with a "Sample image" badge, so nobody books expecting exactly
 *   that bouquet. When the real photograph arrives, save it without ".sample"
 *   (addon-bouquet-s.jpg): it wins automatically. Then delete the sample.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { decorations } from '../data/decorations';
import { setups, addonGroups } from '../data/booking';
import room from '../assets/decor/trendy-2.jpeg';

const names: Record<string, string> = {
  ...Object.fromEntries(setups.map((s) => [`setup-${s.id}`, `${s.name}: ${s.tagline}`])),
  ...Object.fromEntries(addonGroups.flatMap((g) =>
    g.options.map((o) => [`addon-${o.id}`, `${g.name}: ${o.name}`]))),
};

const dropped = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../assets/booking/*.{jpg,jpeg,png,webp}', { eager: true }),
).map(([path, mod]) => {
  const base = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  const sample = base.endsWith('.sample');
  const key = base.replace(/\.sample$/, '');
  return { key, src: mod.default, alt: (names[key] ?? key) + (sample ? ' (sample image)' : ''), sample };
})
  // a real photograph comes after its sample, so it wins the de-duplication below
  .sort((a, b) => Number(b.sample) - Number(a.sample));

const media: { key: string; src: ImageMetadata; alt: string; sample?: boolean }[] = [
  ...decorations.map((d) => ({ key: `decor-${d.id}`, src: d.photos[0].src, alt: d.photos[0].alt })),
  {
    key: 'setup-date', src: room,
    alt: 'The room from the doorway: the projection screen on one side, a decorated backdrop and fog over a floor of balloons on the other.',
  },
  // a photograph dropped in src/assets/booking/ wins over anything above with the same key
  ...dropped,
].filter((m, i, all) => all.findLastIndex((x) => x.key === m.key) === i);
---
<template id="bkMedia">
  {media.map((m) => (
    <Image src={m.src} alt={m.alt} data-media={m.key} data-sample={m.sample ? '' : undefined}
           {...(m.key.startsWith('addon-')
             // add-on cards are small portrait tiles: two across on a phone, 190px wide at most
             ? { widths: [200, 400], sizes: '(max-width: 640px) 46vw, 190px', quality: 72 }
             : { widths: [360, 720], sizes: '(max-width: 640px) 92vw, 340px' })}
           loading="lazy" decoding="async" />
  ))}
</template>
