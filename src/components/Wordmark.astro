---
/**
 * The logo's lettering on its own — YOUR, with the eclipse for its O, over
 * S P Λ C E — cropped straight from the supplied artwork
 * (src/assets/brand/wordmark.png, from the artwork at 205,330 → 1015,780, with
 * room above for the eclipse's glow and the edges feathered so no crop line shows).
 *
 * A soft glow breathes over the crescent; see Logo.astro for how the light
 * is laid on. The eclipse sits at 45.7% across, 42% down this crop.
 */
import { Image } from 'astro:assets';
import word from '../assets/brand/wordmark.png';
---
<span class="brand-word">
  <Image src={word} alt="" widths={[160, 320, 480]} sizes="160px" loading="eager" decoding="async" />
  <span class="ys-halo" aria-hidden="true"></span>
</span>
