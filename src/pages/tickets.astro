---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import TicketStub from '../components/TicketStub.astro';
import PriceList from '../components/PriceList.astro';
import PackageCards from '../components/PackageCards.astro';
import DecorDeck from '../components/DecorDeck.astro';
import { MAX_GUESTS } from '../data/booking';
---
<Base title="Tickets & Add-ons — YourSpace Jabalpur"
      description="Sessions from ₹1,500 for up to 7 guests. Every setup, decoration and add-on price, listed before you book.">
  <PageHead crumb="Tickets">
    <h1 class="headline">One price for the room.<br />Everything else is <em>yours to choose</em>.</h1>
    <p class="standfirst">No packages you have to decode, and no price that changes once you're in the room. This page lists everything we charge for. If it isn't here, we don't charge for it.</p>
  </PageHead>

  <section class="band band-paper">
    <div class="shell">
      <div class="tickets-grid">
        <TicketStub />
        <PriceList as="h2" />
      </div>
    </div>
  </section>

  <section class="band" id="decorations">
    <div class="shell">
      <header class="sec-head">
        <p class="rule-label"><i>Decoration</i><span>Three ways to dress the room</span></p>
        <h2 class="title">Pick how the room <em>looks</em>.</h2>
        <p class="standfirst">Three setups, each built before you arrive so you walk into it finished. Turn a card over for what's in it.</p>
      </header>
      <DecorDeck />
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <header class="sec-head">
        <p class="rule-label"><i>Setups</i><span>What you actually book</span></p>
        <h2 class="title">Pick the <em>kind</em> of night.</h2>
        <p class="standfirst">Each one is the private room for your whole session. Date Night adds a decoration of your choice, and the add-ons above.</p>
      </header>
      <PackageCards />
    </div>
  </section>

  <section class="band band-book">
    <div class="shell narrow">
      <p class="rule-label"><i>Plainly</i><span>What this price is not</span></p>
      <h2 class="title">No surprises at the <em>door</em>.</h2>
      <ul class="stub-list" style="margin-bottom:28px">
        <li>Taxes and applicable charges are added on top of the prices above — we'll show you the final amount before you confirm.</li>
        <li>Up to {MAX_GUESTS} guests book online. Karaoke needs at least 3; for fewer, call us.</li>
        <li>Food and drink beyond the listed add-ons isn't included.</li>
        <li>Pay by UPI when you book, or after we call — your choice. If we can't give you the slot, you get it back in full.</li>
      </ul>
      <div class="hero-actions">
        <button class="btn btn-key btn-lg" data-book>Book a slot<span aria-hidden="true">→</span></button>
        <a class="btn btn-line btn-lg" href="/faq/">Read the questions</a>
      </div>
    </div>
  </section>
</Base>
