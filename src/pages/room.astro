---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Notice from '../components/Notice.astro';
import Reel from '../components/Reel.astro';
import { BASE_GUESTS, MAX_GUESTS, ROOM_BASE } from '../data/booking';
---
<Base title="The Room — YourSpace Jabalpur"
      description="One private room in Jabalpur: big-screen projection, dedicated sound, lounge seating, and nobody else in it but your group.">
  <PageHead crumb="The room">
    <h1 class="headline">The lights go down.<br />The room is <em>yours</em>.</h1>
    <p class="standfirst">One private space in Jabalpur, booked by the session. Nobody walks in, nobody rushes you out, and the setup changes to match whatever you're celebrating.</p>
  </PageHead>

  <section class="band">
    <div class="shell room-grid">
      <figure class="room-art reveal" aria-hidden="true">
        <div class="room-screen"><span class="room-glow"></span></div>
        <div class="room-seats"><span /><span /><span /><span /><span /><span /></div>
        <figcaption class="fine">Lights down, screen up, seats facing one way.</figcaption>
      </figure>
      <div class="reveal">
        <p class="rule-label"><i>Spec</i><span>What's in it</span></p>
        <h2 class="title">Built for one group<br />at a <em>time</em>.</h2>
        <dl class="credits">
          <div><dt>Privacy</dt><dd>The whole room reserved for your group, start to finish. No shared seating, no second booking running alongside yours.</dd></div>
          <div><dt>Screen &amp; sound</dt><dd>Big-screen projection with a dedicated sound system.</dd></div>
          <div><dt>Seating</dt><dd>Lounge seating arranged around your group.</dd></div>
          <div><dt>Capacity</dt><dd>Up to {BASE_GUESTS} guests on the base price of ₹{ROOM_BASE.toLocaleString('en-IN')}, and up to {MAX_GUESTS} in the room.</dd></div>
          <div><dt>Session</dt><dd>2 hours 30 minutes, start to finish.</dd></div>
          <div><dt>Make it yours</dt><dd>Decor, cake, flowers and food available as add-ons.</dd></div>
        </dl>
        <p class="fine">Exact equipment and seating details are being finalised — we'll confirm them with you when we call.</p>
      </div>
    </div>
  </section>

  <section class="band band-paper">
    <div class="shell">
      <header class="sec-head">
        <p class="rule-label"><i>House rules</i><span>So everyone gets the same room</span></p>
        <h2 class="title">A short list, and we <em>mean</em> all of it.</h2>
      </header>
      <div class="tickets-grid">
        <div class="pricelist reveal">
          <h3 class="pricelist-head">Yes, please</h3>
          <ul class="leaders">
            <li><span>Your own playlist or film</span><b>Welcome</b></li>
            <li><span>Your own cake</span><b>Tell us first</b></li>
            <li><span>Decorating something yourself</span><b>Tell us first</b></li>
            <li><span>Photos and video of your own group</span><b>Welcome</b></li>
            <li><span>Running over by a few minutes</span><b>If the next slot is free</b></li>
          </ul>
        </div>
        <div class="pricelist reveal">
          <h3 class="pricelist-head">Please don't</h3>
          <ul class="leaders">
            <li><span>Smoking inside the room</span><b>Not allowed</b></li>
            <li><span>Moving the screen or speakers</span><b>Ask us</b></li>
            <li><span>Open flames you brought yourself</span><b>Ask us</b></li>
            <li><span>More guests than you booked for</span><b>Tell us first</b></li>
          </ul>
          <p class="fine">If something here would spoil your plan, ask — most of it is a conversation, not a rule.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <header class="sec-head">
        <p class="rule-label"><i>In the room</i><span>Set up three different ways</span></p>
        <h2 class="title">Three ways we <em>dress</em> the room.</h2>
        <p class="standfirst">These photographs show the decoration setups you can choose from. Pull the strip along, or see all three with prices on the <a href="/tickets/#decorations">tickets page</a>.</p>
      </header>
      <Reel />
    </div>
  </section>

  <section class="band">
    <div class="shell narrow">
      <Notice label="Note">
        The pictures above show the decoration setups. We'll add photographs of the room
        itself — empty, in daylight — as soon as it is finished, so you can see the space
        as well as the dressing.
      </Notice>
      <h2 class="title">Want to see it <em>first</em>?</h2>
      <p class="standfirst">Pre-book a slot and we'll call you before we open. If you'd rather see the space before you commit, say so on the call and we'll arrange it.</p>
      <div class="hero-actions">
        <button class="btn btn-key btn-lg" data-book>Pre-book a slot<span aria-hidden="true">→</span></button>
        <a class="btn btn-line btn-lg" href="/tickets/">See what it costs</a>
      </div>
    </div>
  </section>
</Base>
