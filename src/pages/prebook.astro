---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PrebookForm from '../components/PrebookForm.astro';
---
<Base title="Pre-book · YourSpace Jabalpur"
      description="Tell us what you would book and when. No payment and no card details. We call you to confirm.">
  <PageHead crumb="Pre-book">
    <h1 class="headline">Rather <em>talk</em> it through?</h1>
    <p class="standfirst">Tell us what you'd like and when, and we'll call you to confirm the slot. You can pay once it's confirmed.</p>
  </PageHead>

  <section class="band">
    <div class="shell book-grid">
      <div class="reveal">
        <p class="rule-label"><i>Plainly</i><span>What this is</span></p>
        <h2 class="title">A request, <em>not</em> a payment.</h2>
        <ul class="stub-list">
          <li>Nothing to pay to send this</li>
          <li>We call you to confirm your date and group size</li>
          <li>Pay after the call, online or by a link we send</li>
          <li>If you change your mind, there is nothing to cancel</li>
        </ul>
        <p class="fine">Ready to choose your setup, decoration and add-ons? <a href="/book/">Use the full booking flow</a>.</p>
        <p class="fine">Prefer to talk? <a data-call href="#">Call us</a>.</p>
      </div>
      <PrebookForm />
    </div>
  </section>
</Base>
