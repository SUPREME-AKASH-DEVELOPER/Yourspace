---
import Base from '../layouts/Base.astro';
---
<Base title="Thanks — YourSpace Jabalpur"
      description="Your request is in. We will call you to confirm your slot."
      noindex>
  <section class="band" style="padding-top:clamp(60px,9vw,120px)">
    <div class="shell">
      <div class="done-wrap">
        <div class="done-mark" aria-hidden="true"></div>
        <p class="rule-label" style="justify-content:center"><i>Received</i><span>We have your request</span></p>
        <h1 class="headline">That's <em>in</em>.</h1>
        <p class="standfirst" style="margin-inline:auto">We'll call you to confirm the date, the time and your group size. Nothing has been charged, and nothing will be until you've confirmed with us directly.</p>
        <div class="hero-actions" style="justify-content:center">
          <a class="btn btn-key btn-lg" href="/programme/">See the programme<span aria-hidden="true">→</span></a>
          <a class="btn btn-line btn-lg" href="/">Back to home</a>
        </div>
        <p class="fine">Something to add? <a data-wa href="#">Message us on WhatsApp</a> or <a data-call href="#">call us</a>.</p>
      </div>
    </div>
  </section>
</Base>
