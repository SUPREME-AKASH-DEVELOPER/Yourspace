---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import WhatsApp from '../components/WhatsApp.astro';
---
<Base title="Book a Slot — YourSpace Jabalpur"
      description="Book a private session at YourSpace Jabalpur. Pick your occasion, date, guests, time and setup, then pay online by UPI, card or netbanking.">
  <PageHead crumb="Book">
    <h1 class="headline">Let's build your <em>night</em>.</h1>
    <p class="standfirst">Six short steps: the occasion, the date and guests, the time, the setup, any add-ons, and payment. Pay online straight away or after we call — your choice.</p>
  </PageHead>

  <section class="band" style="padding-top:clamp(30px,4vw,54px)">
    <div class="shell">
      <!-- the booking flow mounts here, inline instead of as a modal -->
      <div id="bookMount"></div>
      <WhatsApp message="Hi YourSpace, I have a question before I book." />
    </div>
  </section>

  <section class="band band-paper">
    <div class="shell narrow">
      <p class="rule-label"><i>Reassurance</i><span>Before you worry about it</span></p>
      <h2 class="title">Paying is <em>simple</em>, and safe.</h2>
      <ul class="stub-list" style="margin-bottom:26px">
        <li>Pay online by UPI, card or netbanking through Razorpay's secure checkout. Your card and bank details go to Razorpay, never to this site.</li>
        <li>Rather pay later? Choose that at the end, and we send the details after we call.</li>
        <li>We call you to confirm the date, the time and your group size. You get a receipt by email the moment your payment goes through.</li>
        <li>If we can't give you the slot, you get a full refund.</li>
      </ul>
      <p class="fine">Questions first? <a href="/faq/">Read the common ones</a> or <a href="/contact/">talk to us</a>.</p>
    </div>
  </section>
</Base>
