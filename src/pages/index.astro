---
import Base from '../layouts/Base.astro';
import ProgrammeRow from '../components/ProgrammeRow.astro';
import TicketStub from '../components/TicketStub.astro';
import PriceList from '../components/PriceList.astro';
import Faq from '../components/Faq.astro';
import PrebookForm from '../components/PrebookForm.astro';
import Marquee from '../components/Marquee.astro';
import Reel from '../components/Reel.astro';
import { experiences, OTHER, ROOM_BASE, RUNTIME, BASE_GUESTS } from '../data/booking';
import { homeFaq } from '../data/faq';
---
<Base
  title="YourSpace Jabalpur — A Private Screening Room for Your People"
  description="A private room in Jabalpur for watch parties, karaoke, date nights, proposals, candlelight dinners and stand-up evenings. Sessions from ₹1,499 for up to 4 guests."
>

<section class="hero" id="top">
  <div class="beam" id="beam" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="plate plate-live">
        <span class="plate-dot" aria-hidden="true"></span>
        <span data-greeting>Now booking</span> · Jabalpur · Opening soon
      </p>
      <h1 class="headline">The whole room,<br /><em>just</em> your people.</h1>
      <p class="lede">A private space in Jabalpur you book by the session — for watch parties, karaoke nights, date nights, proposals, candlelight dinners and stand-up evenings. Nobody else walks in.</p>
      <div class="hero-actions">
        <button class="btn btn-key btn-lg" data-book>Pre-book a slot<span aria-hidden="true">→</span></button>
        <a class="btn btn-line btn-lg" href="/programme/">See the programme</a>
      </div>
      <dl class="hero-spec">
        <div><dt>From</dt><dd class="num">₹{ROOM_BASE.toLocaleString('en-IN')}</dd></div>
        <div><dt>Runtime</dt><dd class="num">{RUNTIME}</dd></div>
        <div><dt>Admits</dt><dd class="num">Up to {BASE_GUESTS}</dd></div>
        <div><dt>Today</dt><dd class="num">₹0</dd></div>
      </dl>
      <p class="fine suggestion" data-daily-pick></p>
      <p class="fine">Pre-booking takes no payment and no card details. We call you to confirm the slot before anything is charged.</p>
    </div>

    <form class="ticket" id="quickStart" novalidate>
      <div class="ticket-head">
        <p class="ticket-title">Plan your night</p>
        <p class="ticket-no">No. <span class="num">001</span></p>
      </div>
      <div class="ticket-body">
        <label class="tfield">
          <span class="tlabel">Occasion</span>
          <select name="experience" id="qExperience">
            <option value="">Choose one…</option>
            {experiences.map((e) => <option>{e.name}</option>)}
            <option value={OTHER.id}>{OTHER.name}…</option>
          </select>
        </label>
        <label class="tfield" id="qCustomField" hidden>
          <span class="tlabel">{OTHER.prompt}</span>
          <input type="text" name="custom" id="qCustom" maxlength="200"
                 placeholder="A farewell, a reveal, a surprise…" />
        </label>
        <div class="tfield-row">
          <label class="tfield">
            <span class="tlabel">Date</span>
            <input type="date" name="date" id="qDate" />
          </label>
          <label class="tfield">
            <span class="tlabel">Guests</span>
            <input type="number" name="guests" id="qGuests" min="1" max="12" value="2" inputmode="numeric" />
          </label>
        </div>
      </div>
      <div class="ticket-tear" aria-hidden="true"></div>
      <div class="ticket-stub">
        <button class="btn btn-key full" type="submit">Check availability<span aria-hidden="true">→</span></button>
        <p class="fine center">Under a minute · nothing to pay</p>
      </div>
    </form>
  </div>
</section>

<Marquee />

<section class="band" id="decor-preview">
  <div class="shell">
    <header class="sec-head">
      <p class="rule-label"><i>The room</i><span>Dressed three ways</span></p>
      <h2 class="title">This is what you're <em>walking into</em>.</h2>
      <p class="standfirst">Three decoration setups, built before you arrive. Pull the strip along, or tap a frame to see it full size.</p>
    </header>
    <Reel />
    <p class="fine"><a href="/tickets/#decorations">See all three, with prices →</a></p>
  </div>
</section>

<section class="band" id="experiences">
  <div class="shell">
    <header class="sec-head">
      <p class="rule-label"><i>Reel 01</i><span>The programme</span></p>
      <h2 class="title">Six ways to use <em>one</em> room.</h2>
      <p class="standfirst">Same private space, set up six different ways. Pick the one that fits the night, then add the decor, food and extras you want.</p>
    </header>
    <ol class="programme">
      {experiences.map((exp, i) => <ProgrammeRow exp={exp} index={i} />)}
    </ol>
  </div>
</section>

<section class="band band-room" id="room">
  <div class="shell room-grid">
    <figure class="room-art reveal" aria-hidden="true">
      <div class="room-screen"><span class="room-glow"></span></div>
      <div class="room-seats"><span /><span /><span /><span /><span /><span /></div>
      <figcaption class="fine">Lights down, screen up, seats facing one way.</figcaption>
    </figure>
    <div class="reveal">
      <p class="rule-label"><i>Reel 02</i><span>The room</span></p>
      <h2 class="title">The lights go down.<br />The room is <em>yours</em>.</h2>
      <p class="standfirst">One private space in Jabalpur, booked by the session. Nobody walks in, nobody rushes you out, and the setup changes to match whatever you're celebrating.</p>
      <dl class="credits">
        <div><dt>Privacy</dt><dd>The whole room reserved for your group, start to finish</dd></div>
        <div><dt>Screen &amp; sound</dt><dd>Big-screen projection with a dedicated sound system</dd></div>
        <div><dt>Seating</dt><dd>Lounge seating arranged around your group</dd></div>
        <div><dt>Session</dt><dd>2 hours 30 minutes, start to finish</dd></div>
      </dl>
      <p class="fine"><a href="/room/">More about the room →</a></p>
    </div>
  </div>
</section>

<section class="band band-steps">
  <div class="shell">
    <header class="sec-head">
      <p class="rule-label"><i>Reel 03</i><span>How it works</span></p>
      <h2 class="title">Three steps, <em>start</em> to finish.</h2>
    </header>
    <ol class="steps">
      <li class="reveal"><p class="step-no num">01</p><h3>Tell us the occasion</h3><p>Pick your experience, your date and how many people are coming. We'll show you what fits.</p></li>
      <li class="reveal"><p class="step-no num">02</p><h3>Make it yours</h3><p>Add the decor, food and extras you want. Every option shows its price before you add it.</p></li>
      <li class="reveal"><p class="step-no num">03</p><h3>Confirm and show up</h3><p>Check the details, confirm your slot, and walk into a room that's already set up for you.</p></li>
    </ol>
  </div>
</section>

<section class="band band-paper" id="pricing">
  <div class="shell">
    <header class="sec-head">
      <p class="rule-label"><i>Reel 04</i><span>Tickets</span></p>
      <h2 class="title">One price for the room.<br />Everything else is <em>yours to choose</em>.</h2>
      <p class="standfirst">One straightforward base price. Everything optional is priced separately, and you see it before you add it.</p>
    </header>
    <div class="tickets-grid">
      <TicketStub />
      <PriceList />
    </div>
  </div>
</section>

<section class="band" id="faq">
  <div class="shell narrow">
    <header class="sec-head">
      <p class="rule-label"><i>Reel 05</i><span>Questions</span></p>
      <h2 class="title">Answered <em>plainly</em>.</h2>
    </header>
    <Faq items={homeFaq} />
    <p class="fine"><a href="/faq/">All questions →</a></p>
  </div>
</section>

<section class="band band-book" id="prebook">
  <div class="shell book-grid">
    <div class="reveal">
      <p class="rule-label"><i>Reel 06</i><span>Pre-book</span></p>
      <h2 class="title">Get in <em>before</em> we open.</h2>
      <p class="standfirst">We're opening soon in Jabalpur. Tell us what you'd book and when, and we'll call you to lock your slot before we open to everyone.</p>
      <ul class="stub-list">
        <li>No payment now, and no card details</li>
        <li>We call you to confirm your date and group size</li>
        <li>First slots go to people who pre-book</li>
      </ul>
      <p class="fine">Prefer to talk? <a data-call href="#">Call us</a> or <a data-wa href="#">message us on WhatsApp</a>.</p>
    </div>
    <PrebookForm />
  </div>
</section>

</Base>
