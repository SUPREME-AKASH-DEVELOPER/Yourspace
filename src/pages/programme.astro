---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProgrammeRow from '../components/ProgrammeRow.astro';
import { experiences } from '../data/booking';
---
<Base title="The Programme — Six Ways to Use the Room · YourSpace Jabalpur"
      description="Date nights, watch parties, karaoke, proposals, candlelight dinners and stand-up evenings in a private room in Jabalpur.">
  <PageHead crumb="Programme">
    <h1 class="headline">Six ways to use <em>one</em> room.</h1>
    <p class="standfirst">The room never changes. What we put in it does. Pick the night you're planning and we'll set the room up for it before you arrive — you walk in, and it's already done.</p>
  </PageHead>

  <section class="band">
    <div class="shell">
      <ol class="programme">
        {experiences.map((exp, i) => <ProgrammeRow exp={exp} index={i} detailed as="h2" />)}
      </ol>
    </div>
  </section>

  <section class="band band-paper">
    <div class="shell">
      <header class="sec-head">
        <p class="rule-label"><i>Also</i><span>Not on the list?</span></p>
        <h2 class="title">If it fits in a room,<br />we can probably <em>set it up</em>.</h2>
        <p class="standfirst">Birthdays, anniversaries, farewells, reveals, a screening of a film nobody else wanted to watch with you. Tell us what you're planning and we'll tell you honestly whether the room suits it.</p>
      </header>
      <a class="btn btn-key btn-lg" href="/contact/">Ask us about your night<span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
