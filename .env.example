# YourSpace Jabalpur
#
# The site builds with no environment variables. Most settings a human needs
# to change live in src/data/site.ts; the email function needs the key below.

# The public origin, used for canonical URLs, the sitemap and OG images.
# Defaults to https://www.yourspacejbp.com (astro.config.mjs).
# PUBLIC_SITE_URL="https://www.yourspacejbp.com"

# Server-side only (never prefix with PUBLIC_, that would ship it to browsers).
# Set in Vercel: Project > Settings > Environment Variables. Read by api/send.js.
# RESEND_API_KEY=""                  required, or customers get no email
# NOTIFY_TO="tanishkofficial27@gmail.com"   optional, who gets the leads
# NOTIFY_CC="badalakki11@gmail.com"         optional, copied on the leads
# MAIL_FROM="YourSpace Jabalpur <bookings@yourspacejbp.com>"   optional
