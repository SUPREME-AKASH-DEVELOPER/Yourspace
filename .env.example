# YourSpace Jabalpur
#
# The site builds and runs with no environment variables — every setting a
# human needs to change lives in src/data/site.ts instead, so the team can
# edit it without touching deployment config.
#
# This file exists for when that stops being true. Copy it to `.env` and fill
# in what you need; `.env` is gitignored.

# The public origin, used for canonical URLs, the sitemap and OG images.
# Overrides the default in astro.config.mjs when set in your host's dashboard.
# PUBLIC_SITE_URL="https://yourspace.in"

# If you move bookings off WhatsApp onto a real endpoint, put it here.
# PUBLIC_BOOKING_ENDPOINT=""

# Server-side only (never prefix with PUBLIC_ — that would ship it to browsers).
# BOOKING_API_KEY=""
